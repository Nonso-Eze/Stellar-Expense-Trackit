# Database — PostgreSQL (Neon, Supabase, or Vercel Postgres)
# For local dev you can use a local Postgres instance or Neon free tier
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# For Neon/pooled connections, also set DIRECT_URL (same value if not pooled)
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stellar Network — use "testnet" for dev, "mainnet" for production
NEXT_PUBLIC_STELLAR_NETWORK="testnet"

# Stellar Horizon server URL
NEXT_PUBLIC_HORIZON_URL="https://horizon-testnet.stellar.org"

# USDC asset issuer on testnet (change for mainnet)
NEXT_PUBLIC_USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
